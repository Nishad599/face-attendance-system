# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
# ============================================================

# --- Database -------------------------------------------------
# Leave blank for SQLite (default: attendance.db) — recommended for a single server.
# For PostgreSQL, use a full URL. NOTE: special characters in the password must be
# URL-encoded (e.g. '@' becomes %40).
#   DATABASE_URL=postgresql://attend_user:Secret%40123@localhost:5432/attendance_db
DATABASE_URL=

# --- Email (monthly reports, welcome emails, password reset) ---
# Gmail requires an APP PASSWORD (16 chars), not your normal account password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Leave SMTP_USER/SMTP_PASSWORD blank to disable email entirely (the app still works).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CDAC Attendance

# Public URL of this app — used for links inside emails.
APP_BASE_URL=https://YOUR.SERVER.IP:8000

# --- Anti-spoofing (liveness) ---------------------------------
# ANTISPOOF_DISABLED=1        disables liveness everywhere (attendance included)
# ANTISPOOF_ON_REGISTRATION=1 enforces liveness during face registration
#                             (off by default: registration is staff-supervised)
# ANTISPOOF_THRESHOLD=0.45    lower = more lenient
LATE_GRACE_MINUTES=10

# --- Security -------------------------------------------------
# Session cookies are Secure by default (this app serves HTTPS).
# Set to 0 ONLY if you deliberately run over plain HTTP.
COOKIE_SECURE=1
# Lock an account out after this many failed logins within the window.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=10
